[Unit]
Description=Date Invite Telegram notify API
After=network.target

[Service]
Type=simple
User=cursor
WorkingDirectory=/home/cursor/meeting-notify
EnvironmentFile=/home/cursor/meeting-notify/.env
ExecStart=/usr/bin/node /home/cursor/meeting-notify/notify.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
